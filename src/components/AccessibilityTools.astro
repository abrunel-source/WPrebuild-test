---
/**
 * Lightweight accessibility toolbar (replaces the WordPress pojo-accessibility
 * widget on the original site). Toggles text size, high contrast, readable
 * font, and link underlines; preferences persist in localStorage.
 */
---

<div class="a11y">
  <button class="a11y__toggle" aria-expanded="false" aria-controls="a11y-panel" title="Accessibility Tools">
    <span aria-hidden="true">♿</span>
    <span class="screen-reader-text">Accessibility Tools</span>
  </button>
  <div id="a11y-panel" class="a11y__panel" hidden>
    <p class="a11y__title">Accessibility Tools</p>
    <button data-a11y="text-larger">Increase text</button>
    <button data-a11y="text-smaller">Decrease text</button>
    <button data-a11y="contrast">High contrast</button>
    <button data-a11y="readable">Readable font</button>
    <button data-a11y="underline">Underline links</button>
    <button data-a11y="reset" class="a11y__reset">Reset</button>
  </div>
</div>

<script>
  const KEY = 'fcca-a11y';
  const root = document.documentElement;
  const state = JSON.parse(localStorage.getItem(KEY) || '{}');
  let scale = state.scale || 1;

  function apply() {
    root.style.fontSize = scale === 1 ? '' : `${scale * 100}%`;
    root.classList.toggle('a11y-contrast', !!state.contrast);
    root.classList.toggle('a11y-readable', !!state.readable);
    root.classList.toggle('a11y-underline', !!state.underline);
    localStorage.setItem(KEY, JSON.stringify({ ...state, scale }));
  }
  apply();

  const toggle = document.querySelector('.a11y__toggle');
  const panel = document.getElementById('a11y-panel');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });

  document.querySelectorAll<HTMLButtonElement>('[data-a11y]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.a11y;
      if (action === 'text-larger') scale = Math.min(1.5, scale + 0.1);
      else if (action === 'text-smaller') scale = Math.max(0.8, scale - 0.1);
      else if (action === 'reset') {
        scale = 1;
        state.contrast = state.readable = state.underline = false;
      } else if (action) {
        state[action] = !state[action];
      }
      apply();
    });
  });
</script>

<style is:global>
  .a11y-contrast {
    filter: contrast(1.2);
  }
  .a11y-contrast body {
    background: #000 !important;
    color: #fff !important;
  }
  .a11y-readable body,
  .a11y-readable :where(h1, h2, h3, h4, h5, h6, p, a, li, span, button) {
    font-family: Arial, Helvetica, sans-serif !important;
  }
  .a11y-underline a {
    text-decoration: underline !important;
  }
</style>

<style>
  .a11y {
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    z-index: 150;
  }
  .a11y__toggle {
    background: var(--color-primary);
    color: #fff;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    cursor: pointer;
    font-size: 1.3rem;
    box-shadow: var(--shadow-sm);
  }
  .a11y__panel {
    position: absolute;
    right: 48px;
    top: 0;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    padding: var(--space-sm);
    display: grid;
    gap: 0.4rem;
    width: 190px;
  }
  .a11y__title {
    margin: 0 0 0.25rem;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-secondary);
  }
  .a11y__panel button {
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.6rem;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .a11y__panel button:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .a11y__reset {
    background: var(--color-secondary) !important;
    color: #fff;
  }
</style>
