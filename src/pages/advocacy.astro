---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 6);

const priorities = [
  { title: 'Heat', body: 'Protecting Floridians from the rising health threat of extreme heat.' },
  { title: 'Greening Public Schools', body: 'Healthier, more resilient learning environments for students and staff.' },
  { title: 'Young People Climate Lawsuit', body: 'Standing with young Floridians defending their right to a healthy environment.' },
  { title: 'Anti-Incinerator Action', body: 'Opposing polluting incinerators that harm community health and air quality.' },
  { title: 'Outdoor Worker Advocacy', body: 'Championing heat protections for the workers most exposed to extreme conditions.' },
];
---

<BaseLayout title="Advocacy" description="Advancing health-centered environmental policy in Florida.">
  <section class="page-hero page-hero--split">
    <div class="container page-hero__inner">
      <div>
        <p class="eyebrow" style="color:#fff">Advocacy</p>
        <h1>Advocacy</h1>
        <p>Advancing health-centered environmental policies that prioritize those in urgent need.</p>
      </div>
      <div class="page-hero__circle">
        <img src="/media/2023/07/two-volunteers-different-races-hold-paper-show-how-important-it-is-take-care-environment-volunteering-concept_1212-7574-transformed-e1689622968793.jpeg" alt="FCCA advocates" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head"><p class="eyebrow">Advocacy</p><h2>Our Priorities</h2></header>
      <div class="grid grid--3">
        {priorities.map((p) => (
          <div class="card priority">
            <div class="card__body">
              <h3 class="card__title">{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="content">
      <p class="eyebrow">Advocacy Committee</p>
      <h2>Clinicians as trusted messengers</h2>
      <p>
        Our Advocacy Committee, chaired by <strong>Carol Lindsey</strong>, mobilizes
        empowered volunteers to educate policymakers and communities on the health impacts of
        heat, pollution, and extreme weather events — especially for the most vulnerable
        patients. The committee tracks legislation, organizes calls to action, and equips
        clinicians with the tools to make the health case for environmental solutions.
      </p>
      <p>
        Want to get involved? <a href="/contact/">Reach out to the committee.</a>
      </p>
      <p><a class="button" href="#footer">Join us</a></p>
    </div>
  </section>

  {news.length > 0 && (
    <section class="section">
      <div class="container">
        <header class="section-head section-head--row">
          <div>
            <p class="eyebrow">News</p>
            <h2>Statewide News</h2>
          </div>
          <a class="button button--ghost" href="/news/">View all</a>
        </header>
        <div class="grid grid--3">
          {news.map((n) => (
            <article class="card">
              {n.data.image && (
                <a class="card__media" href={`/news/${n.id}/`}><img src={n.data.image} alt={n.data.title} loading="lazy" /></a>
              )}
              <div class="card__body">
                <span class="tag">{n.data.category}</span>
                <h3 class="card__title"><a href={`/news/${n.id}/`}>{n.data.title}</a></h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--surface">
    <div class="content">
      <p class="eyebrow">Find us</p>
      <h2>Our Locations</h2>
      <p>FCCA organizes across Florida — including South Florida and statewide virtual programming.</p>
    </div>
  </section>

  <style>
    .section-head--row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-md);
      flex-wrap: wrap;
      margin-bottom: var(--space-xl);
    }
    .priority .card__body p {
      margin: 0;
      color: var(--color-text-muted);
    }
  </style>
</BaseLayout>
