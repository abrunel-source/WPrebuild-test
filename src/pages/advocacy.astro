---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 3);
---

<BaseLayout title="Advocacy" description="Advancing equitable, health-centered climate policy in Florida.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow" style="color:#fff">Advocate</p>
      <h1>Advocacy</h1>
      <p>Advancing equitable and just, health-centered climate policies across Florida.</p>
    </div>
  </section>

  <section class="section">
    <div class="content">
      <p class="eyebrow">Advocacy Committee</p>
      <h2>Clinicians as trusted messengers</h2>
      <p>
        Our goal is to advance equitable, health-centered climate policy. We mobilize our
        empowered clinicians to educate policymakers and their communities on the health
        impacts of climate change — especially for the most vulnerable patients.
      </p>
      <p>
        The Advocacy Committee tracks legislation, organizes calls to action, and equips
        clinicians with the tools and talking points to make the health case for climate
        solutions. Want to get involved? <a href="/contact/">Reach out to the committee.</a>
      </p>
      <p><a class="button" href="#footer">Join us</a></p>
    </div>
  </section>

  {news.length > 0 && (
    <section class="section section--surface">
      <div class="container">
        <header class="section-head section-head--row">
          <div>
            <p class="eyebrow">News</p>
            <h2>Statewide News</h2>
          </div>
          <a class="button button--ghost" href="/news/">View all</a>
        </header>
        <div class="grid grid--3">
          {news.map((n) => (
            <article class="card">
              {n.data.image && (
                <a class="card__media" href={`/news/${n.id}/`}><img src={n.data.image} alt={n.data.title} loading="lazy" /></a>
              )}
              <div class="card__body">
                <span class="tag">{n.data.category}</span>
                <h3 class="card__title"><a href={`/news/${n.id}/`}>{n.data.title}</a></h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <style>
    .section-head--row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-md);
      flex-wrap: wrap;
      margin-bottom: var(--space-xl);
    }
  </style>
</BaseLayout>
