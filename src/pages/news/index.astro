---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
);
const press = all.filter((n) => n.data.category !== 'FCCA News');
const fcca = all.filter((n) => n.data.category === 'FCCA News');

const newsletters = (await getCollection('newsletters', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 8);
---

<BaseLayout title="News & Newsletters" description="FCCA in the press, press releases, and our newsletter archive.">
  <section class="page-hero page-hero--split">
    <div class="container page-hero__inner">
      <div>
        <p class="eyebrow" style="color:#fff">Mentions</p>
        <h1>News and Newsletters</h1>
      </div>
      <div class="page-hero__circle">
        <img src="/media/2023/07/large-group-medical-experts-listening-colleague-during-online-meeting_236854-37409-transformed-copy.jpeg" alt="FCCA in the press" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow">Climate change in the press</p>
        <h2>Latest News</h2>
      </header>
      <div class="news-grid">
        {press.map((n) => (
          <a class="news-card" href={`/news/${n.id}/`}>
            <span class="news-card__media">
              {n.data.image && <img src={n.data.image} alt="" loading="lazy" />}
              <span class="news-card__badge">{n.data.title}</span>
            </span>
            <span class="news-card__more">Learn more <span class="news-card__arrow" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {fcca.length > 0 && (
    <section class="section section--sage">
      <div class="container">
        <header class="section-head section-head--center">
          <p class="eyebrow">Mentioned in the press</p>
          <h2>FCCA News</h2>
        </header>
        <div class="news-grid">
          {fcca.map((n) => (
            <a class="news-card" href={`/news/${n.id}/`}>
              <span class="news-card__media">
                {n.data.image && <img src={n.data.image} alt="" loading="lazy" />}
                <span class="news-card__badge">{n.data.title}</span>
              </span>
              <span class="news-card__more">Learn more <span class="news-card__arrow" aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--navy">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow" style="color:var(--color-accent)">Internal news</p>
        <h2>Newsletters</h2>
      </header>
      <div class="nl-grid">
        {newsletters.map((n) => (
          <a class="nl-pill" href={n.data.externalUrl || '/newsletters/'} target={n.data.externalUrl ? '_blank' : undefined} rel={n.data.externalUrl ? 'noopener' : undefined}>
            {n.data.title}
          </a>
        ))}
      </div>
      <p style="text-align:center;margin-top:var(--space-lg)">
        <a class="button button--accent" href="/newsletters/">View all newsletters</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .section-head--center {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-lg);
  }
  .news-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .news-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .news-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--color-sage);
  }
  .news-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .news-card__badge {
    position: absolute;
    inset: auto var(--space-sm) var(--space-sm) var(--space-sm);
    background: rgba(18, 45, 65, 0.92);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.25;
    padding: 0.6em 0.8em;
    border-radius: var(--radius-sm);
  }
  .news-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--color-secondary);
    padding: var(--space-md);
    margin-top: auto;
  }
  .news-card__arrow {
    display: inline-grid;
    place-items: center;
    width: 1.8em;
    height: 1.8em;
    border-radius: 50%;
    background: var(--color-secondary);
    color: #fff;
    font-size: 0.85em;
  }
  .nl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: var(--space-md);
  }
  .nl-pill {
    background: #fff;
    color: var(--color-secondary);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    text-align: center;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease;
  }
  .nl-pill:hover {
    transform: translateY(-2px);
    color: var(--color-primary);
  }
</style>
