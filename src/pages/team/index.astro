---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const team = (await getCollection('team', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Our Team" description="Meet the leadership team of Florida Clinicians for Climate Action.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow" style="color:#fff">About</p>
      <h1>The Leadership Team</h1>
      <p>The clinicians and advocates leading Florida Clinicians for Climate Action.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3 team-grid">
        {team.map((member) => (
          <a class="card team-card" href={`/team/${member.id}/`}>
            {member.data.photo && (
              <span class="team-card__photo">
                <img src={member.data.photo} alt={member.data.title} loading="lazy" />
              </span>
            )}
            <span class="card__body">
              <span class="card__title">{member.data.title}</span>
              {member.data.role && <span class="team-card__role">{member.data.role}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .team-card {
    text-decoration: none;
    color: inherit;
    text-align: center;
  }
  .team-card__photo {
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--color-surface-2);
    overflow: hidden;
  }
  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .team-card .card__body {
    align-items: center;
  }
  .team-card__role {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
