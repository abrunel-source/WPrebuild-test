---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'privacy-policy');
const { Content } = entry ? await render(entry) : { Content: null };
---

<BaseLayout title="Privacy Policy" description="How Florida Clinicians for Climate Action handles your data.">
  <section class="page-hero">
    <div class="container"><h1>Privacy Policy</h1></div>
  </section>
  <article class="section">
    <div class="content prose">
      {Content ? <Content /> : <p>Privacy policy content is being migrated.</p>}
    </div>
  </article>
</BaseLayout>
