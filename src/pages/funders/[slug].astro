---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const partners = await getCollection('partners', ({ data }) => !data.draft);
  return partners.map((p) => ({ params: { slug: p.id }, props: { partner: p } }));
}

const { partner } = Astro.props;
const { title, logo, mission, grantDate, amount, status, gallery, progress } = partner.data;
const { Content } = await render(partner);
const grantLabel = grantDate
  ? grantDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : null;
const milestones = [...progress].sort((a, b) => b.date.localeCompare(a.date));
function ms(d: string) {
  return new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title={title} description={mission} image={logo}>
  <section class="page-hero">
    <div class="container"><h1>Our Partners</h1></div>
  </section>

  <div class="container funder-layout section">
    <article>
      {logo && <img class="funder-logo" src={logo} alt={title} />}
      <h2>{title}</h2>
      {mission && <p class="lead">{mission}</p>}
      <div class="prose"><Content /></div>

      {milestones.length > 0 && (
        <section class="timeline-wrap">
          <h3>Progress</h3>
          <ol class="timeline" role="list">
            {milestones.map((m) => (
              <li class="timeline__item">
                <span class="timeline__date">{ms(m.date)}</span>
                <p class="timeline__text">{m.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      {gallery.length > 0 && (
        <section class="gallery-wrap">
          <h3>Gallery</h3>
          <div class="gallery">
            {gallery.map((g) => (
              <a href={g} target="_blank" rel="noopener"><img src={g} alt="" loading="lazy" /></a>
            ))}
          </div>
        </section>
      )}

      <p style="margin-top:var(--space-xl)"><a href="/funders/">← Back to funders</a></p>
    </article>

    <aside>
      <div class="grant-card">
        {logo && <img class="grant-card__logo" src={logo} alt={title} />}
        <dl>
          <div><dt>Grant date</dt><dd>{grantLabel || '—'}</dd></div>
          <div><dt>Amount</dt><dd>{amount || '—'}</dd></div>
          <div><dt>Status</dt><dd><span class="status">{status}</span></dd></div>
        </dl>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .funder-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-xl);
    align-items: start;
  }
  .funder-logo {
    max-width: 240px;
    margin-bottom: var(--space-md);
  }
  .grant-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: var(--space-lg);
    position: sticky;
    top: 90px;
  }
  .grant-card__logo {
    max-height: 56px;
    width: auto;
    margin-bottom: var(--space-md);
  }
  .grant-card dl {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .grant-card div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.4rem;
  }
  .grant-card dt {
    font-weight: 700;
    color: var(--color-secondary);
  }
  .grant-card dd {
    margin: 0;
    color: var(--color-text-muted);
    text-align: right;
  }
  .status {
    background: var(--color-accent);
    color: var(--color-secondary);
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.15em 0.7em;
    border-radius: 999px;
  }

  .timeline-wrap {
    margin-top: var(--space-xl);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-inline-start: 2px solid var(--color-border);
  }
  .timeline__item {
    position: relative;
    padding: 0 0 var(--space-lg) var(--space-lg);
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-primary);
  }
  .timeline__date {
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.85rem;
  }
  .timeline__text {
    margin: 0.25rem 0 0;
  }

  .gallery-wrap {
    margin-top: var(--space-xl);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-sm);
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 820px) {
    .funder-layout {
      grid-template-columns: 1fr;
    }
    .grant-card {
      position: static;
    }
  }
</style>
