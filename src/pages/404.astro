---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="page-hero">
    <div class="container"><h1>404</h1></div>
  </section>
  <div class="content not-found">
    <h2>Page not found</h2>
    <p>Sorry, the page you were looking for doesn't exist or may have moved.</p>
    <p>
      <a class="button" href="/">Back to home</a>
      <a class="button button--ghost" href="/education/">Browse resources</a>
      <a class="button button--ghost" href="/events/">See events</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding-block: var(--space-2xl);
  }
  .not-found p:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-top: var(--space-lg);
  }
</style>
