---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const events = (await getCollection('events', ({ data }) => !data.draft))
  .filter((e) => e.data.date && (e.data.date as Date) >= now)
  .sort((a, b) => (a.data.date as Date).valueOf() - (b.data.date as Date).valueOf())
  .slice(0, 3);

const pillars = [
  {
    title: 'Impact',
    body: 'From September 2022 to September 2024, Project C-HOT trained over 1,000 clinicians and patients at 40 locations, reaching thousands of Floridians as extreme weather events such as hurricanes and heat waves intensified.',
  },
  {
    title: 'Service',
    body: 'The program also benefits volunteers, as health professionals learn to incorporate climate health into their practices — enhancing their ability to care for climate-impacted populations.',
  },
  {
    title: 'Practical Education',
    body: 'Volunteers educate residents on how to safely store medications during heat waves, how to stay cool outside while waiting for public transportation, and why their neighborhood is hotter than others.',
  },
  {
    title: 'Growth',
    body: 'Three major donors funded Project C-HOT’s expansion: Allegany Franciscan Ministries, Tampa Bay Regional Resiliency Coalition, and the CDC Foundation.',
  },
];
---

<BaseLayout
  title="Project C-HOT"
  description="The Climate Health Outreach Team (C-HOT) and Doula C-HOT programs."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow" style="color:#fff">Project C-HOT</p>
      <h1>Climate Health is Community Health!</h1>
    </div>
  </section>

  <section class="section">
    <div class="content">
      <p class="lead">
        Florida Clinicians for Climate Action developed and launched the "Climate Health
        Outreach Team Program" (Project C-HOT) to deliver essential climate education to
        underserved and highly vulnerable communities across Florida.
      </p>
      <p>
        FCCA partners with community health centers, schools, and churches to train
        volunteers — from high school students to retired professionals — to serve as
        "climate health educators." These volunteers teach local residents about climate
        change and its impact on health, particularly in areas with high heat vulnerability.
      </p>
      <p><strong>Project C-HOT saves lives, strengthens community resilience, and improves public health.</strong></p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <header class="section-head"><p class="eyebrow">Project C-HOT</p><h2>How it works</h2></header>
      <div class="grid grid--2">
        {pillars.map((p) => (
          <div class="card chot-card">
            <div class="card__body">
              <h3 class="card__title">{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="content">
      <p class="eyebrow">A C-HOT initiative</p>
      <h2>Doula C-HOT</h2>
      <p>
        Doula C-HOT empowers local doulas through specialized training to use risk-assessment
        tools that identify and address the needs of pregnant and postpartum people in the
        face of climate-related disasters such as floods and extreme heat. Doulas learn to
        recognize climate-related health risks and put effective, community-centered support
        into practice.
      </p>
      <p><a class="button" href="/contact/">Get involved</a></p>
    </div>
  </section>

  {events.length > 0 && (
    <section class="section section--surface">
      <div class="container">
        <header class="section-head section-head--row">
          <div><p class="eyebrow">Events</p><h2>Upcoming Trainings &amp; Events</h2></div>
          <a class="button button--ghost" href="/events/">See all events</a>
        </header>
        <div class="grid grid--3">
          {events.map((event) => (
            <article class="card">
              {event.data.image && (
                <a class="card__media" href={`/events/${event.id}/`}><img src={event.data.image} alt={event.data.title} loading="lazy" /></a>
              )}
              <div class="card__body">
                <span class="tag">Event</span>
                <h3 class="card__title"><a href={`/events/${event.id}/`}>{event.data.title}</a></h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <style>
    .section-head--row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-md);
      flex-wrap: wrap;
      margin-bottom: var(--space-xl);
    }
    .chot-card .card__body p {
      margin: 0;
      color: var(--color-text-muted);
    }
  </style>
</BaseLayout>
