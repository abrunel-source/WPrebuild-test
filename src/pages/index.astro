---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

// Upcoming events first, then most recent. Mirrors the homepage "Upcoming Events".
const now = new Date();
const allEvents = (await getCollection('events', ({ data }) => !data.draft)).filter((e) => e.data.date);
const upcoming = allEvents
  .filter((e) => (e.data.date as Date) >= now)
  .sort((a, b) => (a.data.date as Date).valueOf() - (b.data.date as Date).valueOf());
const past = allEvents
  .filter((e) => (e.data.date as Date) < now)
  .sort((a, b) => (b.data.date as Date).valueOf() - (a.data.date as Date).valueOf());
const homeEvents = [...upcoming, ...past].slice(0, 3);

const pillars = [
  {
    title: 'Educate',
    body: 'Goal: educate clinicians and communities on the health effects of heat, pollution, and extreme weather events. How: free in-person education, expert online lecture series, and access to collaborative climate and health resources.',
    href: '/education/',
    img: '/media/2023/07/happy-businessman-giving-presentation-group-colleagues-doctors-1.jpg',
  },
  {
    title: 'Engage',
    body: 'Goal: build a community of health-focused volunteers who share information and support health-centered policy. How: virtual and in-person social events across the state, community health education, and media features.',
    href: '/events/',
    img: '/media/2023/07/two-volunteers-different-races-hold-paper-show-how-important-it-is-take-care-environment-volunteering-concept_1212-7574-transformed-e1689622968793.jpeg',
  },
  {
    title: 'Advocate',
    body: 'Goal: advance health-centered environmental policies that prioritize those in urgent need. How: mobilize empowered volunteers to educate policymakers and communities on the health impacts of heat, pollution, and extreme weather events.',
    href: '/advocacy/',
    img: '/media/2023/07/happy-black-doctor-talking-presenter-during-educational-event-convention-center.jpg',
  },
];
---

<BaseLayout
  title="Home"
  description="Florida Clinicians for Climate Action — clinicians educating clinicians on the health impacts of heat, pollution, and extreme weather events."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Who we are</p>
        <h1>Clinicians Educating Clinicians on the Health Impacts of Heat, Pollution, and Extreme Weather Events</h1>
        <p class="lead">
          As clinicians in Florida, we educate and engage clinicians and everyday Floridians
          to protect their communities against the health harms of heat, pollution, and
          extreme weather events — both now and for the future — with fair and timely public
          health responses.
        </p>
        <div class="hero__cta">
          <a class="button button--accent" href={site.donateUrl} target="_blank" rel="noopener">Donate</a>
          <a class="button button--ghost" href="/about/">About us</a>
        </div>
      </div>
      <div class="hero__media">
        <img
          src="/media/2023/07/Knee-Joint-Examination_edited-copy.jpg"
          alt="A clinician examining a patient"
          width="400"
          height="600"
          loading="eager"
        />
        <img
          src="/media/2023/07/large-group-medical-experts-listening-colleague-during-online-meeting_236854-37409-transformed-copy.jpeg"
          alt="Medical experts listening during a meeting"
          width="400"
          height="600"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">What we do</p>
        <h2>You Can Be An Agent For Change</h2>
        <p class="lead">
          From our proprietary community education initiative — Project C-HOT — to working
          with elected officials, FCCA is the first stop for those looking to promote
          positive changes in the overall health of Floridians year-round.
        </p>
      </header>
      <div class="grid grid--3 pillars">
        {pillars.map((p) => (
          <a class="pillar card" href={p.href}>
            <span class="card__media"><img src={p.img} alt="" loading="lazy" /></span>
            <span class="card__body">
              <span class="card__title">{p.title}</span>
              <span class="pillar__body">{p.body}</span>
              <span class="pillar__more">Learn more →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Mission band -->
  <section class="section mission">
    <div class="container mission__inner">
      <div>
        <p class="eyebrow">Our health</p>
        <h2>Environmental Disasters Are Harming Our Health</h2>
        <p>
          Some people are more vulnerable than others, and if we do nothing the dangers to
          our well-being will keep increasing. As clinicians, we are the trusted messengers
          who play an important role in protecting public health.
        </p>
        <p>
          At Florida Clinicians for Climate Action, we're promoting initiatives to serve the
          people who need them most. Our mission is to educate, engage, and advocate — raising
          public awareness about the health impacts of heat, pollution, and extreme weather
          events.
        </p>
        <a class="button" href="/contact/">Get involved</a>
      </div>
      <img src="/media/2023/07/Doctor-Office_edited.jpg" alt="Clinicians in conversation" loading="lazy" />
    </div>
  </section>

  <!-- Events -->
  {homeEvents.length > 0 && (
    <section class="section section--surface">
      <div class="container">
        <header class="section-head section-head--row">
          <div>
            <p class="eyebrow">Get involved</p>
            <h2>Upcoming Events</h2>
          </div>
          <a class="button button--ghost" href="/events/">See all events</a>
        </header>
        <div class="grid grid--3">
          {homeEvents.map((event) => <EventCard event={event} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Heat-safety brochure -->
  <section class="section">
    <div class="container brochure">
      <div class="brochure__copy">
        <p class="eyebrow">Our brochure</p>
        <h2>Protect Yourself Against the Heat</h2>
        <p>Dozens die in Miami-Dade County each year due to heat.</p>
        <p>
          Learn the warning signs and precautions for heat illness and exhaustion with our
          free brochure.
        </p>
        <a class="button" href="/media/2024/07/HeatHealth-English.png" target="_blank" rel="noopener">
          Read the brochure
        </a>
      </div>
      <a class="brochure__media" href="/media/2024/07/HeatHealth-English.png" target="_blank" rel="noopener">
        <img src="/media/2024/07/HeatHealth-English.png" alt="FCCA Heat & Health brochure" loading="lazy" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, #f1f6f6 0%, #e6eeee 100%);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  .hero__media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }
  .hero__media img {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 2 / 3;
  }
  .hero__media img:first-child {
    margin-top: var(--space-lg);
  }

  .section-head {
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }
  .section-head--row {
    max-width: none;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .pillars .pillar {
    text-decoration: none;
    color: inherit;
  }
  .pillar__body {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .pillar__more {
    margin-top: auto;
    font-weight: 700;
    color: var(--color-primary);
  }

  .mission__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-xl);
  }
  .mission__inner img {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .brochure {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }
  .brochure__media img {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-inline: auto;
    max-height: 460px;
    width: auto;
  }
  @media (max-width: 880px) {
    .brochure {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 880px) {
    .hero__inner,
    .mission__inner {
      grid-template-columns: 1fr;
    }
    .hero__media {
      order: -1;
    }
  }
</style>
