# Copy to .env and fill in real values for LOCAL dev only.
# In production these live in Vercel -> Project -> Settings -> Environment Variables.
# NEVER commit real values. (.env is gitignored.)

# --- Newsletter opt-in (footer) ---
# Mailchimp server/transactional key. SERVER-SIDE ONLY. The datacenter (e.g. "us4")
# is the part after the dash in the key and is derived automatically.
MAILCHIMP_API_KEY=
# The Audience/List ID the footer form subscribes people to (Mailchimp ->
# Audience -> Settings -> "Audience name and defaults" -> Audience ID).
MAILCHIMP_AUDIENCE_ID=

# --- Contact form delivery ---
# Where contact submissions are emailed.
CONTACT_TO_EMAIL=info@floridaclinicians.org
# Transactional email provider key (Resend by default). See src/pages/api/contact.ts.
RESEND_API_KEY=

# --- Decap CMS GitHub OAuth (/admin) ---
# From the GitHub OAuth App (Settings -> Developer settings -> OAuth Apps).
# Callback URL must be https://<your-site>/api/callback. SERVER-SIDE ONLY.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Google Maps ---
# Browser-exposed key. MUST be restricted by HTTP referrer to floridaclinicians.org
# in Google Cloud Console. Injected at build via PUBLIC_ prefix.
PUBLIC_GOOGLE_MAPS_API_KEY=
